# Independent of all email/issuance profiles. Generate the hash with the password CLI.
WEB_PASSWORD_HASH=
WEB_ORIGIN=http://localhost:8080
WEB_EVENT_ID=freshcoat-synthetic
WEB_TIMEZONE=Asia/Manila
WEB_SYNTHETIC=true
# Explicit one-server local SQLite mode. No per-device databases.
WEB_DATABASE_URL=sqlite:///.web-runtime/web.sqlite3
# Optional private Compose database secret (generate your own; no default):
WEB_POSTGRES_PASSWORD=
# Or start Compose and use PostgreSQL (replace the password):
# WEB_DATABASE_URL=postgresql+psycopg://freshcoat:REPLACE_WITH_LOCAL_DB_PASSWORD@localhost:54329/freshcoat
WEB_FIXTURE=.web-runtime/sheets.json
WEB_SESSION_SECONDS=28800
WEB_SYNC_SECONDS=45
# Later activation only; HTTPS + PostgreSQL required. See docs/WEB_APP.md.
WEB_LIVE_CONFIG=
WEB_LIVE_EXPORT=false
