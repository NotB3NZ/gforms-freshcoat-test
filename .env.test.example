# Test profile. Copy to .env.test; real values stay private.
# Copy to .env inside event-checkin. Enter real values ONLY in that local file.
# First checkpoint: fill these four values and the exact form headers.

SPREADSHEET_ID=
SHEET_TAB=
EVENT_ID=
EVENT_TIMEZONE=Asia/Manila
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
NAME_HEADER=Full Name
EMAIL_HEADER=Email
EMAIL_ENABLED=false
# Optional JSON overrides for ANY header; see config/headers.example.json.
HEADERS_FILE=

# Local paths resolve against the event-checkin project root.
RUNTIME_DIR=runtime
GENERATED_DIR=generated
FRESHCOAT_DIR=freshcoat
# Leave BUN_BIN unset to auto-find Bun or ~/.bun/bin/bun.
# BUN_BIN=/absolute/path/to/bun
CARD_TEMPLATE=templates/card.coat
CARD_NAME_FIELD=displayName
CARD_FRAME=front
# Pixels at scale 1, including the QR white quiet zone; actual card is 1200 x 900.
QR_X=400
QR_Y=450
QR_SIZE=400
WORKER_POLL_SECONDS=30
# Conservative default to reduce Sheets quota pressure; --once handles one queued row.
WORKER_BATCH_SIZE=1

# Separate staff credential. Generate locally later; never use a ticket token here.
STAFF_API_KEY=
CHECKIN_SERVER_URL=http://127.0.0.1:8000
CAMERA_INDEX=0
# Non-secret station label recorded in checked_in_by; use a distinct label per scanner.
STAFF_STATION_NAME=Local staff station

# Keep false until the test recipient is identified and the email test is authorized.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
